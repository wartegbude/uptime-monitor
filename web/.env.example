# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Random 32+ character strings (e.g. `openssl rand -base64 32`)
SESSION_SECRET=change-me-to-a-long-random-string-32chars-min
ENCRYPTION_KEY=change-me-another-long-random-string-32chars
CRON_SECRET=change-me-cron-secret

# Public URL of this app (used in the agent install command)
APP_URL=https://your-app.vercel.app

# Where install.sh downloads the agent binary from (GitHub Releases of your fork)
AGENT_RELEASE_BASE=https://github.com/YOUR_GITHUB_USER/uptime-monitor/releases/latest/download

# Docker image for the agent (built by .github/workflows/agent-release.yml)
AGENT_IMAGE=ghcr.io/YOUR_GITHUB_USER/uptime-agent:latest
